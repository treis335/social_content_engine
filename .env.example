# ===================================================
# KARMA COURT — Variaveis de ambiente
# Copia este ficheiro para ".env" e preenche com as tuas chaves reais.
# NUNCA commites o ficheiro ".env" real para o GitHub.
# ===================================================

# --- LLM (geracao de historias/ideias) ---
# DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# --- Together AI (voz, transcricao para legendas, e imagem de fundo) ---
# https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# Modelo de TTS (voz). Boa opcao em ingles: canopylabs/orpheus-3b-0.1-ft (mais natural)
TOGETHER_TTS_MODEL=canopylabs/orpheus-3b-0.1-ft
# TOGETHER_TTS_VOICE ja NAO e usado como default — a voz agora e escolhida no
# painel de "Definicoes" da dashboard (guardado em data/settings.json) e pode
# ser trocada a qualquer momento sem reiniciar o servidor. Isto fica so como
# fallback tecnico caso o ficheiro de definicoes nao exista.
TOGETHER_TTS_VOICE=tara
# Modelo de imagem para gerar os fundos automaticamente (efeito Ken Burns)
TOGETHER_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- YouTube (publicacao automatica) ---
# Criados na Google Cloud Console (OAuth2 Client ID - Desktop App)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Configuracao geral ---
CHANNEL_NAME=Karma Court
# NICHE tambem passa a ser configuravel no painel "Definicoes" da dashboard
# (estilo de video). Isto fica so como valor inicial/fallback.
NICHE=revenge_justice_stories
VIDEOS_PER_DAY=2
TIMEZONE=Europe/Lisbon

# --- Assets (opcional agora — se a pasta estiver vazia, o sistema gera o
# fundo automaticamente com IA em vez de precisar de clips manuais) ---
BACKGROUND_CLIPS_DIR=./assets/backgrounds
MUSIC_DIR=./assets/music
